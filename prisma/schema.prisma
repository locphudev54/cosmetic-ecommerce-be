model ProductVariant {
  id String @id @default(uuid())

  productId String

  sku          String @unique
  name         String
  barcode      String?  @default("")
  costPrice    Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)
  stockOnHand  Int?   @default(0) // inventory quantity
  // imageUrl     String @default("")
  fileId String? // ← replaces imageUrl String; nullable for safe migration
  lowStockThreshold Int @default(0)
  maxStockThreshold Int @default(0)
  isActive     Boolean @default(true)

  product                  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues          VariantAttributeValue[]
  file   File?   @relation(fields: [fileId], references: [id])
  inboundTransactionItems  InboundTransactionDetail[]
  outboundTransactionItems OutboundTransactionDetail[]
  orderDetails             OrderDetail[]
  cartItems                CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([stockOnHand])
  @@index([sellingPrice])
  @@index([fileId])
  // Variant filtering
  @@index([productId, isActive, stockOnHand])
  @@index([productId, sellingPrice])
  @@map("ProductVariant")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @default("")
  parentId    String?  // default value of this field is null -> top-level category, otherwise it's a child category 
  fileId      String?   // ← replaces imageUrl String; nullable for safe migration
  
  // Materialized path for performance
  path        String    @default("/") 
  depth       Int       @default(0)
  isActive    Boolean   @default(true)
  // facetInheritanceMode FacetInheritanceMode @default(INHERIT) // INHERIT, OVERRIDE, MERGE
  
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    ProductCategory[]
  categoryAttributes  CategoryAttribute[]
  collectionCategories CollectionCategory[]
  file        File?     @relation(fields: [fileId], references: [id])
  
  // SEO fields
  metaTitle       String?
  metaDescription String?
  
  // Soft delete
  isDeleted Boolean @default(false)
  deletedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([parentId])
  @@index([path])
  @@index([slug])
  @@index([isActive])
  @@index([fileId])
  @@map("Category")
}

enum FacetInheritanceMode {
  INHERIT   // Child categories inherit parent's attributes unless they define their own
  OVERRIDE  // Child categories do not inherit any attributes from parent
  MERGE     // Child categories inherit parent's attributes and can add their own (union of both)
}

model Brand {
  id String @id @default(uuid())

  name     String @default("")
  fileId   String? // ← replaces imageUrl String; nullable for safe migration

  products Product[]
  file     File?  @relation(fields: [fileId], references: [id])

    
  // Soft delete
  isDeleted Boolean @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([fileId])
  @@map("Brand")
}

model CountryOfOrigin {
  id String @id @default(uuid())

  name String @default("")

  products Product[]

  // Soft delete
  isDeleted Boolean @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@map("CountryOfOrigin")
}

model StockBatch {
  id String @id @default(uuid())

  code String? @unique
  expirationDate DateTime
  importingQuantity Int

  inboundDetails  InboundTransactionDetail[]
  outboundDetails OutboundTransactionDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([expirationDate])
  @@map("StockBatch")
}

model InboundTransaction {
  id String @id @default(uuid())

  supplierId String
  createById String

  code String? @unique
  status InventoryTransactionStatus @default(DRAFT)
  totalImportingPrice Decimal @db.Decimal(10, 2)
  receivedDate DateTime
  note String @default("")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  createBy User @relation("InboundCreator", fields: [createById], references: [id])
  details InboundTransactionDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([supplierId])
  @@index([createById])
  @@index([status])
  @@map("InboundTransaction")
}

model InboundTransactionDetail {
  id String @id @default(uuid())

  productVariantId String
  stockBatchId String
  inboundTransactionId String

  importingPrice Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)
  importingQuantity Int
  totalImportingPrice Decimal @db.Decimal(10, 2)
  discountType DiscountType
  discountValue Decimal @db.Decimal(10, 2)
  note String @default("")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id])
  inboundTransaction InboundTransaction @relation(fields: [inboundTransactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([productVariantId])
  @@index([stockBatchId])
  @@index([inboundTransactionId])
  @@map("InboundTransactionDetail")
}

model User {
  id String @id @default(uuid())

  email String? @unique
  googleId   String? @unique
  facebookId String? @unique   
  password String?
  code String @unique
  fullName String? @default("") // when has @default here, the value of this filed can be empty string "" -> nullable
  phoneNumber String? @default("")
  isActive Boolean? @default(true)
  avatarUrl String? @default("")
  role UserRole? @default(CUSTOMER)

  orders Order[]
  cart Cart?
  addresses Address[]
  refreshTokens RefreshToken[]
  passwordResetToken PasswordResetToken?
  createdFolders Folder[] @relation("FolderCreator")
  uploadedFiles  File[]   @relation("FileUploader")

  createdInboundTransactions InboundTransaction[] @relation("InboundCreator")
  createdOutboundTransactions OutboundTransaction[] @relation("OutboundCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([role])
  @@map("User")
}

model Cart {
  id String @id @default(uuid())

  userId    String?  @unique // Nullable for guest carts
  version   Int      @default(1) // Optimistic locking version
  expiresAt DateTime? // TTL for guest carts (DB backup)

  user User? @relation(fields: [userId], references: [id])

  items      CartItem[]
  totalPrice Decimal @db.Decimal(10, 2) @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([expiresAt])
  @@map("Cart")
}

model CartItem {
  id String @id @default(uuid())

  productVariantId String
  cartId           String
  price            Decimal @db.Decimal(10, 2) // Snapshot of product variant price at the time it was added to cart
  quantity         Int
  subtotal         Decimal @db.Decimal(10, 2)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([cartId, productVariantId]) // Prevent duplicate variants per cart
  @@index([productVariantId])
  @@index([cartId])
  @@map("CartItem")
}

model Order {
  id String @id @default(uuid())

  userId String

  idempotencyKey String? @unique
  code String @unique
  status OrderStatus @default(PROCESSING)
  totalPrice Decimal @db.Decimal(10, 2)
  shippingFee Decimal @db.Decimal(10, 2) @default(0)
  paymentMethod PaymentMethod @default(COD)
  cancelReason String? @default("")

  paidAt DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id])
  items OrderDetail[]

  shippingInfo ShippingInfo?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt, id])
  @@map("Order")
}

model ShippingInfo {
  id String @id @default(uuid())

  orderId String @unique

  fullName String @default("")
  email String @default("")
  phoneNumber String @default("")

  province String @default("")
  district String @default("")
  ward String @default("")
  streetAddress String @default("")
  note String @default("")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@map("ShippingInfo")
}

model Supplier {
  id String @id @default(uuid())

  code        String @unique
  name        String @default("")
  email       String @unique
  phoneNumber String @unique
  address     String @default("")
  note        String @default("")
  companyName String @default("")
  taxCode     String @default("")

  inboundTransactions InboundTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@map("Supplier")
}

model OutboundTransaction {
  id String @id @default(uuid())

  createById String

  code String? @unique
  status InventoryTransactionStatus @default(DRAFT)
  totalImportingPrice Decimal @db.Decimal(10, 2)
  exportedDate DateTime
  note String @default("")

  createBy User @relation("OutboundCreator", fields: [createById], references: [id])
  details OutboundTransactionDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([createById])
  @@index([status])
  @@map("OutboundTransaction")
}

model OutboundTransactionDetail {
  id String @id @default(uuid())

  productVariantId String
  stockBatchId String
  outboundTransactionId String

  exportingQuantity Int
  totalImportingPrice Decimal @db.Decimal(10, 2)
  note String @default("")


  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id])
  outboundTransaction OutboundTransaction @relation(fields: [outboundTransactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([productVariantId])
  @@index([stockBatchId])
  @@index([outboundTransactionId])
  @@map("OutboundTransactionDetail")
}

model OrderDetail {
  id String @id @default(uuid())

  orderId String
  productVariantId String

  quantity Int
  productPrice Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([orderId])
  @@index([productVariantId])
  @@map("OrderDetail")
}

model Address {
  id String @id @default(uuid())

  userId String

  province String @default("")
  district String @default("")
  ward String @default("")
  streetAddress String @default("")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId])
  @@map("Address")
}

model RefreshToken {
  // Don't use default(uuid()) here, because we need to ensure the same jti between DB and JWT Payloads
  id String @id // JTI synchonized with JWT jti claim (in payload) 
  
  userId String

  hashedToken String @unique // Don't store raw token for security reasons
  expiresAt DateTime
  isRevoked Boolean @default(false) // To manually revoke token by system - when user refresh (logout - remove user's RT instead instead of revoking)
  isUsed Boolean @default(false) // To detect reuse attack - used in Atomic Update when refreshing token

  // Just need this field when you want revoke / remove tokens in a chain (parent, child, grand-child, ...)
  // In realworld application, we will remove all of user's refresh tokens when reuse attack is detected
  // replacedByToken String? 

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt 

  @@index([userId])
  @@map("RefreshToken")
}


model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String @unique
  token     String   @unique  
  
  // One-To-One relationship with User
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@map("PasswordResetToken")
}

// Junction table for many-to-many relationship between Product and Category
model ProductCategory {
  productId   String
  categoryId  String
  isPrimary   Boolean   @default(false) // Indicates the main category for the product (for SEO and default filtering)
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  
  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId, isPrimary])
}


// Normalized attribute definitions
model Attribute {
  id          String              @id @default(uuid())
  name        String              @unique // "Color", "Size", "Material" / "Màu sắc" / "Kích thước" / "Chất liệu"
  slug        String              @unique
  // dataType    AttributeDataType   @default(TEXT) // TEXT, NUMBER, BOOLEAN, COLOR

  // Filter-specific fields
  isGlobalFilter  Boolean @default(false) // Show on /collections/all? - True = available across all categories
  // displayName     String? // Override name in filter UI: "Color" → "Shirt Color"
  // unit            String? // "cm", "kg", "GB" for range filters

  values      AttributeValue[]
  // products    ProductAttribute[]
  categoryAttributes  CategoryAttribute[] 
  collectionAttributes CollectionAttribute[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  deletedAt DateTime?
  isDeleted Boolean @default(false)

  @@index([slug])
  @@index([isGlobalFilter])
  @@map("Attribute")
}

enum AttributeDataType {
  TEXT // Default type for general attributes - String
  NUMBER 
  BOOLEAN 
  COLOR
}

model AttributeValue {
  id              String                    @id @default(uuid())
  attributeId     String

  value           String                    // "Red", "Large", "Cotton"
  // displayName     String?                   // For display purposes: "Red" → "Bright Red"
  // displayOrder       Int     @default(0)     // For ordering values in filter UI
  // hexColor        String?                   // For color swatches: "#FF0000"  
  // imageUrl        String?                   // Optional image for this value (e.g. pattern swatch: (pattern/texture))

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean @default(false)

  variants        VariantAttributeValue[]
  attribute       Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("AttributeValue")
}

// Junction table: which variant has which attribute values
model VariantAttributeValue {
  id               String          @id @default(uuid())
  variantId        String
  attributeValueId String

  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue  @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  // rawValue        String          @default("") // For quick access without joining AttributeValue (e.g. "Red", "Large")

  deletedAt DateTime?
  isDeleted Boolean @default(false)

  @@unique([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeValueId])
  @@map("VariantAttributeValue")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String  
  fileId String          // ← replaces url String
  altText   String?
  displayOrder Int? @default(1) // For ordering images in the gallery

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  file   File @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())
  deletedAt DateTime?
  isDeleted Boolean @default(false)

  @@index([productId])
  @@index([fileId])
  @@map("ProductImage")
}

