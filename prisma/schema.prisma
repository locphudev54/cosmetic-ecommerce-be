// (Filter Configuration)
model CategoryAttribute {
  id          String    @id @default(uuid())
  categoryId  String
  attributeId String
  
  // displayName   String? // Override attribute name in filter UI: "Color" → "Shirt Color"
  // displayOrder    Int     @default(0)     // Order in filter UI
  // filterType      FilterDisplayType @default(CHECKBOX) // CHECKBOX, RADIO, SLIDER, SWATCH ~ displayType
  
  // Behavior flags
  // isFilterable    Boolean @default(true)  // Can this be used as a filter?
  // isRequired      Boolean    @default(false)  // Required when adding a product to this category 
  // isCollapsed    Boolean @default(false)  // Should this filter be collapsed by default in the UI?
  // showSearchBox Boolean @default(false)  // Show search box for long lists of values (e.g. brands, countries)

  // Inheritance: if true, child categories inherit this attribute
  // inheritToChildren Boolean @default(true)
  
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean @default(false)
  
  @@unique([categoryId, attributeId])
  // @@index([categoryId, isFilterable])
  @@index([attributeId])
  @@map("CategoryAttribute")
}

model Collection {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?  @default("")
  fileId      String?  // ← replaces imageUrl String; nullable for safe migration
  isActive    Boolean  @default(true)

  products    CollectionProduct[]
  attributes  CollectionAttribute[]
  categories CollectionCategory[]
  file        File?    @relation(fields: [fileId], references: [id])

  publishedAt DateTime? // For scheduling when the collection goes live

  // SEO fields
  metaTitle       String?
  metaDescription String?

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([fileId])
  @@map("Collection")
}

// Junction table: manually assigned products to a collection
model CollectionProduct {
  collectionId String
  productId    String
  displayOrder Int      @default(0) // for manual ordering within the collection page

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
  @@map("CollectionProduct")
}

// Junction table: which attributes (filters) are relevant to a given collection
model CollectionAttribute {
  collectionId String
  attributeId  String
  // displayOrder Int        @default(0) // controls filter panel ordering

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  attribute    Attribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@id([collectionId, attributeId])
  @@index([collectionId])
  @@map("CollectionAttribute")
}

model CollectionCategory {
  collectionId String
  categoryId   String
  // displayOrder Int        @default(0)
  // Tracks whether this was auto-populated from products
  // or explicitly set by an admin. Allows admin override/exclusion.
  // isAutoAdded  Boolean    @default(true)

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@id([collectionId, categoryId])
  @@index([collectionId])
  @@map("CollectionCategory")
}

model Folder {
  id       String  @id @default(uuid())
  name     String
  path     String  // Materialized path for performance, please refer the existing path field in Category model and the existing logic in category service, because the folder structure is similar to category hierarchy

  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")

  createdById String
  createdBy   User   @relation("FolderCreator", fields: [createdById], references: [id])

  files File[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([parentId])
  @@index([createdById])
  @@map("Folder")
}

model File {
  id String @id @default(uuid())

  folderId String
  folder   Folder @relation(fields: [folderId], references: [id])

  originalName        String
  cloudinaryPublicId  String  @unique
  cloudinaryUrl       String
  cloudinarySecureUrl String
  format              String  // "jpg" | "png" | "webp" etc.
  width               Int
  height              Int
  fileSizeBytes       Int

  uploadedById String
  uploadedBy   User   @relation("FileUploader", fields: [uploadedById], references: [id])

  productImages   ProductImage[]
  productVariants ProductVariant[]
  categories       Category[]
  brands           Brand[]
  collections      Collection[]

  createdAt DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([folderId])
  @@index([uploadedById])
  @@index([cloudinaryPublicId])
  @@map("File")
}